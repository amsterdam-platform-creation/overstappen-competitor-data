{
  "energy": {
    "Engie": {
      "rules": [
        {
          "pattern": "Flexibel\\s*contract\\s*Gas\\s*\\+\\s*Elektriciteit|Flex\\s*Gas\\s*\\+\\s*elektriciteit",
          "contract_type": "DUAL",
          "meter_type": "BOTH",
          "duration": "VARIABLE",
          "notes": "Flex/Flexibel = variable dual contract"
        },
        {
          "pattern": "Flexibel\\s*contract\\s*Gas|Flex\\s*Gas",
          "contract_type": "SINGLE",
          "meter_type": "GAS",
          "duration": "VARIABLE",
          "notes": "Flex gas only"
        },
        {
          "pattern": "Flexibel\\s*contract\\s*Elektriciteit|Flex\\s*Elektriciteit",
          "contract_type": "SINGLE",
          "meter_type": "ELECTRICITY",
          "duration": "VARIABLE",
          "notes": "Flex electricity only"
        },
        {
          "pattern": "(\\d+)\\s*jaar\\s*(?:Elektriciteit\\s*&\\s*Gas|Gas\\s*\\+\\s*elektriciteit)",
          "contract_type": "DUAL",
          "meter_type": "BOTH",
          "duration_regex": "(\\d+)\\s*jaar",
          "duration_mapping": {
            "1": "ONE_YEAR",
            "2": "TWO_YEARS",
            "3": "THREE_YEARS",
            "4": "FOUR_YEARS",
            "5": "FIVE_YEARS"
          },
          "notes": "Woolsocks pattern: '3 jaar Elektriciteit & Gas'"
        },
        {
          "pattern": "Gas \\+ elektriciteit:?\\s*(\\d+)\\s*jaar vast",
          "contract_type": "DUAL",
          "meter_type": "BOTH",
          "duration_regex": "(\\d+)\\s*jaar",
          "duration_mapping": {
            "1": "ONE_YEAR",
            "2": "TWO_YEARS",
            "3": "THREE_YEARS",
            "4": "FOUR_YEARS",
            "5": "FIVE_YEARS"
          },
          "notes": "CashbackXL pattern: 'Gas + elektriciteit: 3 jaar vast'"
        },
        {
          "pattern": "(\\d+)\\s*jaar\\s*(?:Gas|Elektriciteit)",
          "contract_type": "SINGLE",
          "meter_type": "EITHER",
          "duration_regex": "(\\d+)\\s*jaar",
          "duration_mapping": {
            "1": "ONE_YEAR",
            "2": "TWO_YEARS",
            "3": "THREE_YEARS",
            "4": "FOUR_YEARS",
            "5": "FIVE_YEARS"
          },
          "notes": "Woolsocks single meter: '3 jaar Gas'"
        },
        {
          "pattern": "Gas:?\\s*(\\d+)\\s*jaar vast",
          "contract_type": "SINGLE",
          "meter_type": "GAS",
          "duration_regex": "(\\d+)\\s*jaar",
          "duration_mapping": {
            "1": "ONE_YEAR",
            "2": "TWO_YEARS",
            "3": "THREE_YEARS",
            "4": "FOUR_YEARS",
            "5": "FIVE_YEARS"
          },
          "notes": "CashbackXL pattern: 'Gas: 1 jaar vast'"
        },
        {
          "pattern": "Elektriciteit:?\\s*(\\d+)\\s*jaar vast",
          "contract_type": "SINGLE",
          "meter_type": "ELECTRICITY",
          "duration_regex": "(\\d+)\\s*jaar",
          "duration_mapping": {
            "1": "ONE_YEAR",
            "2": "TWO_YEARS",
            "3": "THREE_YEARS",
            "4": "FOUR_YEARS",
            "5": "FIVE_YEARS"
          },
          "notes": "CashbackXL pattern: 'Elektriciteit: 3 jaar vast'"
        }
      ]
    },
