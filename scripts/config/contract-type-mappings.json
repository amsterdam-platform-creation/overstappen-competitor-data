      "rules": [
        {
          "pattern": "(\\d+)\\s*jaar\\s*stroom\\s*&\\s*gas|(\\d+)\\s*jaar\\s*(?:stroom|gas)\\s*(?:en|és|\\+|&)\\s*(?:stroom|gas)",
