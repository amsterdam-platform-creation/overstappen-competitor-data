          "pattern": "stroom\\s*&\\s*gas|gas\\s*&\\s*stroom|stroom.*(?:en|és|\\+).*gas|gas.*(?:en|és|\\+).*stroom|elektriciteit.*(?:en|és|\\+|&).*gas",
