          "pattern": "(?:Stroom|[Gg]as)\\s*&\\s*(?:[Ss]troom|gas)",
          "contract_type": "DUAL",
          "meter_type": "BOTH",
          "duration": "ANY",
          "notes": "Dual without years: 'Stroom & gas' or 'Gas & Stroom'"
        },
        {
          "pattern": "(?:Stroom|[Gg]as)\\s*of\\s*(?:[Ss]troom|gas)",
          "contract_type": "SINGLE",
          "meter_type": "EITHER",
          "duration": "ANY",
          "notes": "Single meter: 'Stroom of gas' or 'Gas of Stroom'"
        }
      ]
    },
