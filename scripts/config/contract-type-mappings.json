          "pattern": "stroom\\s*of\\s*gas|gas\\s*of\\s*stroom|alleen\\s*(?:stroom|gas)|(?:stroom|gas)\\s*only",
          "contract_type": "SINGLE",
          "meter_type": "EITHER",
          "notes": "Single meter (either gas or electricity)"
